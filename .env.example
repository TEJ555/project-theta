# Only needed for the optional OpenAI adapter.
OPENAI_API_KEY=
THETA_OPENAI_MODEL=gpt-5.6
THETA_ENABLE_MODEL_RUNS=NO
THETA_CODE_VERSION=

# Optional Anthropic Claude adapter.
ANTHROPIC_API_KEY=
THETA_ANTHROPIC_MODEL=claude-sonnet-4-6

# Claude Code Max subscription adapter. No API key is used.
THETA_CLAUDE_CODE_PATH=
THETA_CLAUDE_CODE_MODEL=sonnet

# Optional local Ollama-compatible endpoint.
THETA_OLLAMA_URL=http://localhost:11434
THETA_OLLAMA_MODEL=llama3.2
